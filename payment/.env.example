# Copy to your environment (export or a private file). NEVER commit real values.
# These are read by the local paygate process. See docs/cdp-a2a-payment-plan.md.

# --- CDP platform API key (CDP Portal → API Keys) ---
CDP_API_KEY_ID=
# base64 Ed25519 (64 bytes) or PEM EC P-256 private key
CDP_API_KEY_SECRET=

# --- CDP wallet secret (CDP Portal → Wallet Secret) ---
# base64 DER EC P-256 PKCS8 private key, used to build the X-Wallet-Auth JWT
CDP_WALLET_SECRET=

# --- Gateway ---
# base-sepolia (default, testnet) | base (mainnet)
CDP_NETWORK=base-sepolia
PAYGATE_LISTEN=127.0.0.1:9001
# default: $HOME/.soulmirror/a2a/pay
PAYGATE_HOME=
